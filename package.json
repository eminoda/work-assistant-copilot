{
  "name": "work-assistant-copilot",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "prisma db push --schema apps/desktop-agent/prisma/schema.prisma",
    "runtime": "pnpm --filter @workcopilot/agent-core dev",
    "prepare:desktop-runtime": "node scripts/prepare-desktop-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "latest",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "latest",
    "prettier": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0"
  }
}