{
  "manifest_version": 3,
  "name": "WorkCopilot",
  "version": "0.1.0",
  "description": "Local-first browser workflow recorder and runner",
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:4317/*", "http://localhost:4317/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open WorkCopilot" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}