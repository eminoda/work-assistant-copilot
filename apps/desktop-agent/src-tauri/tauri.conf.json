{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkCopilot",
  "version": "0.1.0",
  "identifier": "dev.workcopilot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "WorkCopilot", "width": 1180, "height": 760, "minWidth": 860, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:4317 http://localhost:4317 ws://127.0.0.1:4317 ws://localhost:4317; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}